# Postgres connection
# Prefer Vercel-style vars. At minimum set POSTGRES_URL (pooled). If using Prisma, also set POSTGRES_PRISMA_URL.
POSTGRES_URL="postgres://user:password@host:5432/db"
# Optional: non-pooled / Prisma URLs
POSTGRES_URL_NON_POOLING="postgres://user:password@host:5432/db"
POSTGRES_PRISMA_URL="postgres://user:password@host:5432/db?pgbouncer=true"

# Optional: used for server-side absolute fetches in development
NEXT_PUBLIC_BASE_URL="http://localhost:3000"

# Map tiles
# Option A: direct style URL
NEXT_PUBLIC_MAP_STYLE_URL="https://demotiles.maplibre.org/style.json"
# Option B: MapTiler key (preferred for high-res vector tiles)
NEXT_PUBLIC_MAPTILER_KEY="YOUR_MAPTILER_KEY"
# Optional: override the bundled list of cities for ingestion + map endpoints
CITY_GEOJSON_FILENAME="us-top-175-cities.geojson"

# Provider API keys
AMBEE_API_KEY="your_ambee_api_key" # optional
AMBEE_DAILY_QUOTA="200"

# Operator token for /api/ingest and /api/ingest-logs.
# Send it as a header only (x-ingest-token or Authorization: Bearer);
# query-string tokens leak into request logs and browser history.
INGEST_TOKEN="set_a_long_random_string"

# Vercel Cron auth. Vercel sends "Authorization: Bearer $CRON_SECRET" when set.
# Required in EVERY environment: /api/cron/daily-ingest rejects requests without
# a matching CRON_SECRET or INGEST_TOKEN.
CRON_SECRET="set_another_long_random_string"

# Optional: pin the Postgres CA certificate (PEM). Supabase connections verify
# against the bundled Supabase Root 2021 CA by default, so this is only needed
# for other providers or after a Supabase root rotation.
# POSTGRES_CA_CERT="-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----"
# Escape hatch that disables TLS certificate verification. Leave unset.
# POSTGRES_SSL_NO_VERIFY="false"

# Optional: Ambee calls held back from the daily quota so on-demand forecast
# refreshes cannot starve the scheduled ingest. Defaults to the city count.
# AMBEE_FORECAST_RESERVE="175"

# How many cities to ingest in parallel (default 5)
INGEST_CONCURRENCY="5"

# OpenWeather (One Call 3.0 + Air Pollution)
OPENWEATHER_API_KEY="your_openweather_api_key"
# Daily quota to budget calls (informational; logs warn if exceeded)
OPENWEATHER_DAILY_QUOTA=1000

# Development: use mock responses instead of live provider calls
USE_MOCK_DATA="false"
